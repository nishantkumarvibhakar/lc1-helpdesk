{
  "name": "lc1-student-helpdesk",
  "version": "1.0.0",
  "description": "LC1 Student Help Desk - An Initiative by Team Prashant Diwakar",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "cd client && npm install && npm run build",
    "start": "node server/server.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "keywords": [
    "lc1",
    "du",
    "faculty-of-law",
    "helpdesk",
    "student-grievance",
    "team-prashant-diwakar"
  ],
  "author": "Team Prashant Diwakar",
  "license": "MIT"
}
